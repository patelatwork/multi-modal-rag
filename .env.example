# Copy to .env and fill in your keys.

# --- Chat model (Groq) -------------------------------------------------------
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
# Must be a vision-capable model, or figures and tables cannot be read.
# Check https://console.groq.com/docs/models for what is currently served.
GROQ_MODEL=qwen/qwen3.6-27b
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1536
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3
# Set to "none" for reasoning models so <think> blocks stay out of the index.
LLM_REASONING_EFFORT=none

# --- Embeddings --------------------------------------------------------------
# local  = sentence-transformers in-process (default; no key, no rate limit)
# hf_api = Hugging Face Inference API
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Only needed when EMBEDDING_PROVIDER=hf_api
HF_API_TOKEN=

# --- Extraction --------------------------------------------------------------
# pymupdf      = pure-python, no system dependencies (default)
# unstructured = layout detection + OCR; requires poppler and tesseract on PATH
EXTRACTOR_BACKEND=pymupdf
RENDER_DPI=200
OCR_ENABLED=false
CHUNK_SIZE=1400
CHUNK_OVERLAP=200

# --- Storage -----------------------------------------------------------------
INPUT_PDF_DIR=./data/pdfs
EXTRACTION_DIR=./data/extracted
VECTOR_STORE_DIR=./data/chroma
DOCSTORE_DIR=./data/docstore
COLLECTION_NAME=multimodal_rag

# --- Retrieval ---------------------------------------------------------------
RETRIEVAL_K=6
MAX_IMAGES_PER_ANSWER=2
MAX_CONTEXT_CHARS=6000

# --- Service -----------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=50
LOG_LEVEL=INFO
